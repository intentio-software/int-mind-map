{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "/Applications/*.app" }]
    },
    "dialog:default",
    "updater:default",
    "process:default",
    "fs:default",
    "fs:allow-write",
    "fs:allow-write-file",
    "fs:allow-create",
    "fs:allow-open",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**/*" },
        { "path": "$DOCUMENT/**/*" },
        { "path": "$DESKTOP/**/*" },
        { "path": "$DOWNLOAD/**/*" },
        { "path": "$APPDATA/**/*" }
      ]
    }
  ]
}
